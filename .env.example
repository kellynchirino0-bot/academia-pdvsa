# Variables de Entorno — Academia Virtual Nasser Group PDVSA
# Copia este archivo a .env.local y completa los valores

# JWT Secret (OBLIGATORIO - cámbialo por un valor seguro)
JWT_SECRET=tu_secreto_jwt_aqui_cambiame_en_produccion

# JWT Expiration
JWT_EXPIRES_IN=24h

# Allowed CORS origins (separados por coma)
ALLOWED_ORIGINS=https://academia-pdvsa.vercel.app,http://localhost:3000,http://localhost:5173

# Base de datos (opcional - usa memoria por defecto)
DATABASE_URL=

# CRM / HubSpot (opcional)
CRM_WEBHOOK_URL=
HUBSPOT_ACCESS_TOKEN=